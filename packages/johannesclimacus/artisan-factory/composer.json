{
    "name": "johannesclimacus/artisan-factory",
    "description": "Create models from Artisan via factories",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "JohannesClimacus\\ArtisanFactory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JohannesClimacus\\ArtisanFactory\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JohannesClimacus\\ArtisanFactory\\ArtisanFactoryServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
